/**
 * Converts a large vision/reality gap into unusually strong motivation.
 *
 * @status hypothesis
 */
missionImpossibleDrive(goal) {

    PURPOSE:
        turn a vision-reality gap into motivation

    REQUIRES:
        grandVision(goal)
        powerfulBelief()

    WHEN:
        visionRealityGap = high
        confidence = high
        importanceOfVision = high

    DO:
        frustration = high
        urgency = high
        riskTolerance = high
        patience = low

        drive = drive + visionRealityGap * urgency * frustration


    RISKS:
        impatience
        tunnelVision
        excessiveRiskTolerance
        burnout

  RETURN:
    drive
}
